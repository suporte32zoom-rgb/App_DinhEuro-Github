# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host URL of the application
APP_URL="MY_APP_URL"

# COINGECKO_API_KEY: CoinGecko API Key (Demo or Pro) for real-time crypto quotes
# Used in client (VITE_COINGECKO_API_KEY) and server (COINGECKO_API_KEY)
COINGECKO_API_KEY=""
VITE_COINGECKO_API_KEY=""

# BRAPI_API_KEY: Brapi.dev API token for B3 Brazilian equities in production
# Used in client (VITE_BRAPI_API_KEY) and server (BRAPI_API_KEY / BRAPI_TOKEN)
BRAPI_API_KEY=""
VITE_BRAPI_API_KEY=""

# YAHOO_FINANCE_API_KEY: Optional Yahoo Finance / RapidAPI Key for Wall Street & Indices
YAHOO_FINANCE_API_KEY=""
VITE_YAHOO_FINANCE_API_KEY=""

# VITE_AWESOME_ECONOMY_URL: AwesomeAPI endpoint for 100% public live exchange rates & forex
VITE_AWESOME_ECONOMY_URL="https://economia.awesomeapi.com.br/last/USD-BRL,EUR-BRL,GBP-BRL,CAD-BRL,AUD-BRL,CHF-BRL,JPY-BRL,CNY-BRL,ARS-BRL,BTC-BRL,ETH-BRL"

# FINNHUB_WEBHOOK_SECRET: Secret for validating incoming Finnhub webhooks (optional)
FINNHUB_WEBHOOK_SECRET=""

# FINNHUB_API_KEY: Finnhub API token (optional)
FINNHUB_API_KEY=""
VITE_FINNHUB_API_KEY=""

# FMP_API_KEY: Financial Modeling Prep API Key (optional)
FMP_API_KEY=""
VITE_FMP_API_KEY=""

# ALPHA_VANTAGE_KEY: Alpha Vantage API Key (optional)
ALPHA_VANTAGE_KEY=""
VITE_ALPHA_VANTAGE_KEY=""

